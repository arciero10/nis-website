DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Used only by `npm run ticketing:create-invitation` to seed a hashed invitation.
NIS_GALA_INVITATION_TOKEN=
NIS_GALA_INVITATION_LABEL=Invito NIS Gala 2026
NIS_GALA_INVITATION_MAX_USES=1
NIS_GALA_INVITATION_EXPIRES_AT=
NIS_GALA_INVITATION_PUBLIC_SLUG=gala-2026

# Staff check-in. Configure only as server-side App Service settings.
NIS_STAFF_PIN=
NIS_SUPERADMIN_PIN=
NIS_STAFF_DISPLAY_NAME=Staff
NIS_SUPERADMIN_DISPLAY_NAME=Superadmin
# Optional ISO 8601 window. Database values are used when these are empty.
NIS_GALA_CHECKIN_OPENS_AT=
NIS_GALA_CHECKIN_CLOSES_AT=

# Microsoft Graph application-to-application email delivery (server-side only).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TICKETING_EMAIL_FROM=biglietti@nazionaleitalianasanitari.com
NIS_TICKETING_ADMIN_EMAIL=alessandro.arciero@tiscali.it
CANDIDATURE_TO=info@nazionaleitalianasanitari.com


# Apple Wallet (server-side only). The certificate is the Base64 of the Pass Type ID .p12 file.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE_BASE64=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_CERTIFICATE_BASE64=

# Google Wallet (server-side only). The class must be an Event Ticket class enabled for the issuer.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_ID=
