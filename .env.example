DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Used only by `npm run ticketing:create-invitation` to seed a hashed invitation.
NIS_GALA_INVITATION_TOKEN=
NIS_GALA_INVITATION_LABEL=Invito NIS Gala 2026
NIS_GALA_INVITATION_MAX_USES=1
NIS_GALA_INVITATION_EXPIRES_AT=
NIS_GALA_INVITATION_PUBLIC_SLUG=gala-2026

# Staff check-in. Configure only as a server-side App Service setting.
NIS_CHECKIN_PIN=

# Microsoft Graph application-to-application email delivery (server-side only).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TICKETING_EMAIL_FROM=biglietti@nazionaleitalianasanitari.com
CANDIDATURE_TO=info@nazionaleitalianasanitari.com
